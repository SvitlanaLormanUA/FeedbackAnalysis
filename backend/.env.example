# ─── Core ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ─── Database (PostgreSQL via Prisma) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback?schema=public

# ─── Queue (Redis + BullMQ) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Run the BullMQ worker inside this process (true for single-service deploys)
RUN_WORKER=true

# ─── Auth (JWT, admin panel) ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# Seed admin (created by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# ─── QR token signing ───────────────────────────────────────────────────────
QR_SIGNING_SECRET=change-me-qr-secret

# ─── LLM provider (analysis). Leave empty to use the built-in mock. ─────────
# LLM_PROVIDER=gemini | groq | mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest — a stable alias)
# GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# ─── Telegram notifications. Leave empty to only log alerts. ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
